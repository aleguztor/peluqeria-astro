---
import { site } from '../config/site';
const { title, items } = site.services;
---

<section class="section inverted" id="servicios">
  <div class="container">
    <div class="head reveal">
      <p class="eyebrow">01 — Qué hacemos</p>
      <h2 class="section-title">{title}</h2>
    </div>

    <ul class="list">
      {items.map((s, i) => (
        <li class="row reveal">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="name">{s.name}</h3>
          <p class="desc">{s.desc}</p>
          <span class="price">{s.price}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { margin-bottom: 4rem; }
  .head .section-title { margin-top: 1rem; }
  .list { list-style: none; margin: 0; padding: 0; border-top: var(--line-width) solid var(--color-line); }
  .row {
    display: grid;
    grid-template-columns: 4rem 1.2fr 1.5fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.8rem 1rem;
    border-bottom: var(--line-width) solid var(--color-line);
    transition: background 0.3s, color 0.3s, padding 0.3s;
  }
  /* Hover: la fila se invierte a blanco con texto negro */
  .row:hover { background: var(--color-fg); color: var(--color-bg); padding-inline: 2rem; }
  .row:hover .num, .row:hover .desc { color: inherit; }
  .num { color: var(--color-muted); font-size: 0.9rem; }
  .name { font-family: var(--font-display); font-size: clamp(1.8rem, 4.5vw, 3.5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
  .desc { color: var(--color-muted); }
  .price { font-family: var(--font-serif); font-style: italic; font-size: 1.5rem; white-space: nowrap; }
  @media (max-width: 800px) {
    .row { grid-template-columns: 2.5rem 1fr auto; }
    .desc { grid-column: 2 / -1; grid-row: 2; }
  }
</style>
