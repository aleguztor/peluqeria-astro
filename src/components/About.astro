---
import { site } from '../config/site';
const { title, text, image, stats } = site.about;
---

<section class="section" id="nosotros">
  <div class="container about">
    <img class="about__img reveal" src={image} alt="" />
    <div class="about__body reveal">
      <p class="eyebrow">Desde {site.since}</p>
      <h2 class="section-title">{title}</h2>
      <p class="about__text">{text}</p>
      <dl class="stats">
        {stats.map((s) => (
          <div>
            <dt>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .about__img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-img); }
  .about__body .section-title { font-size: clamp(2.4rem, 5.5vw, 4.5rem); margin: 1rem 0 1.5rem; }
  .about__text { color: var(--color-muted); max-width: 48ch; }
  .stats { display: flex; gap: clamp(1.5rem, 4vw, 3.5rem); margin: 2.5rem 0 0; padding-top: 2rem; border-top: var(--line-width) solid var(--color-line); }
  .stats dt { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .stats dd { margin: 0.4rem 0 0; font-size: 0.85rem; color: var(--color-muted); }
  @media (max-width: 800px) { .about { grid-template-columns: 1fr; } }
</style>
