---
import { site, whatsappUrl } from '../config/site';
---

<header class="header">
  <div class="container header__inner">
    <a href="#top" class="logo">{site.name}<span class="logo__dot">.</span></a>

    <nav class="nav" id="nav">
      {site.nav.map((l) => <a href={l.href} class="nav__link">{l.label}</a>)}
      <a href={whatsappUrl()} class="btn nav__cta" target="_blank" rel="noopener">{site.ctaLabel}</a>
    </nav>

    <button class="burger" id="burger" aria-label="Menú" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    mix-blend-mode: difference;
    color: #fff;
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5rem;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -0.04em;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav__link {
    font-size: 0.95rem;
    position: relative;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -4px;
    width: 100%; height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s;
  }
  .nav__link:hover::after { transform: scaleX(1); transform-origin: left; }
  /* El header usa mix-blend-mode, así que el botón se define en blanco fijo */
  .nav__cta {
    --color-accent: #fff;
    --color-accent-fg: #000;
    padding: 0.55rem 1.2rem;
  }
  .burger { display: none; }

  @media (max-width: 800px) {
    .burger {
      display: block;
      width: 40px; height: 40px;
      background: none; border: 0; cursor: pointer; position: relative; z-index: 60;
    }
    .burger span {
      position: absolute; left: 8px; right: 8px; height: 2px; background: #fff;
      transition: transform 0.3s, top 0.3s;
    }
    .burger span:first-child { top: 15px; }
    .burger span:last-child { top: 23px; }
    .burger[aria-expanded='true'] span:first-child { top: 19px; transform: rotate(45deg); }
    .burger[aria-expanded='true'] span:last-child { top: 19px; transform: rotate(-45deg); }

    .nav {
      position: fixed; inset: 0;
      flex-direction: column; justify-content: center; gap: 1.5rem;
      background: #000;
      font-size: 2rem;
      opacity: 0; pointer-events: none;
      transition: opacity 0.3s;
    }
    .nav :global(.nav__link) { font-size: 2.5rem; font-weight: 700; letter-spacing: -0.03em; }
    .nav.open { opacity: 1; pointer-events: auto; }
  }
</style>

<script>
  const burger = document.getElementById('burger')!;
  const nav = document.getElementById('nav')!;
  const toggle = (open: boolean) => {
    nav.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
  };
  burger.addEventListener('click', () => toggle(!nav.classList.contains('open')));
  nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
</script>
